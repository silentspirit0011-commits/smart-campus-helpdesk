# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=smart-campus-dev-secret-key-change-in-production

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Database Configuration (Leave DB_HOST empty for local SQLite fallback)
DB_HOST=campus-complaints-db.xxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-db-password-here
DB_NAME=campus_complaints
DB_PORT=3306
DATABASE_PATH=campus_complaints.db

# Storage & Uploads (Amazon S3)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
S3_BUCKET_NAME=smart-campus-complaints-br2026x7
AWS_REGION=us-east-1

# Amazon SNS Notifications (Optional Topic ARN for real-time alerts)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:983585032614:smart-campus-notifications

